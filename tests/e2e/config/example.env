#
# TEMPLATE for the per-environment configuration of the E2E suite. The suite never reads this file:
# copy it to tests/e2e/secrets/<env>.env.secret (git-ignored) and fill in the values for your accounts and
# QA fixtures:
#   cp config/example.env secrets/dev.env.secret
#   cp config/example.env secrets/prod.env.secret
# Parsed as KEY=VALUE lines (never sourced). Every key must be present in both files (an empty value
# turns the checks that need it into SKIP). Values shown are the dev endpoints; the prod ones are given
# in the comments. Passwords, tokens and client ids live in secrets/*.secret - see secrets/README.md.

E2E_ENV=dev

# ---- endpoints -------------------------------------------------------------
# prod: https://api-gw.platform.linuxfoundation.org
API_GW=https://api-gw.dev.platform.linuxfoundation.org
# prod: https://api-gw.platform.linuxfoundation.org/cla-service
API_V4=https://api-gw.dev.platform.linuxfoundation.org/cla-service
# prod: https://api-gw.platform.linuxfoundation.org/user-service/v1
USER_SERVICE=https://api-gw.dev.platform.linuxfoundation.org/user-service/v1
# legacy API (cla-backend-legacy); prod: https://api.easycla.lfx.linuxfoundation.org
LEGACY_API=https://api.lfcla.dev.platform.linuxfoundation.org
# status the legacy /v1 token probe is expected to answer (200 on dev, 401 on prod)
LEGACY_V1_TOKEN_EXPECT=200
# prod: https://api.lfcla.com
LEGACY_API_ALIAS=https://api.dev.lfcla.com
# Self Serve (LFX One); prod: https://app.lfx.dev
SS_URL=https://app.dev.lfx.dev
# corporate console: dev = LFX corporate (kind lfx), prod = v1 console https://corporate.v1.easycla.lfx.linuxfoundation.org (kind v1)
CORPORATE_CONSOLE=https://lfx.dev.platform.linuxfoundation.org
CORPORATE_CONSOLE_KIND=lfx
# foundation the corporate console opens (dev only, empty on prod)
CORPORATE_FOUNDATION_SFID=
# prod: https://contributor.easycla.lfx.linuxfoundation.org
CONTRIBUTOR_CONSOLE=https://easycla.dev.communitybridge.org
# prod: https://projectadmin.lfx.linuxfoundation.org
PCC_URL=https://pcc.dev.platform.linuxfoundation.org
# v1 PCC (dev only, empty on prod)
PCC_V1_URL=https://v1.pcc.dev.platform.linuxfoundation.org
# prod: sso.linuxfoundation.org / https://api-gw.platform.linuxfoundation.org/
AUTH0_DOMAIN=linuxfoundation-dev.auth0.com
# extra hosts (comma-separated) that may receive the password, when a console's SSO hop is not AUTH0_DOMAIN
SSO_HOSTS=
AUTH0_AUDIENCE=https://api-gw.dev.platform.linuxfoundation.org/

# ---- AWS (read-only log scans; missing credentials -> SKIP) ----------------
# prod: lfproduct-prod
AWS_PROFILE_E2E=lfproduct-dev
LAMBDA_V4_REGION=us-east-2
LAMBDA_V4_NAME=cla-backend-go-api-v4-lambda
LAMBDA_REGION=us-east-1
# prod: cla-backend-prod
LAMBDA_PREFIX=cla-backend-dev

# ---- identities (user names only; passwords in secrets/auth0-<env>-<lfid>.secret) ----
# ID1 = the account that holds every role (org admin + CLA manager on the fixtures, GitHub linked)
ID1=<lfid>
ID1_EMAIL=<e-mail of ID1>
ID1_UID=<user-service id of ID1 on this environment>
ID1_GITHUB=<GitHub login of ID1>
ID1_GITHUB_ID=<numeric GitHub id of ID1>
ID1_FULLNAME=<full name of ID1>
# ID2 = the account without org-admin/CLA roles (the chains grant and revoke CLA manager on it)
ID2=<lfid>
ID2_EMAIL=<e-mail of ID2>
ID2_GITHUB=<GitHub login of ID2>
ID2_GITHUB_ID=<numeric GitHub id of ID2>
ID2_FIRST=<first name of ID2>
ID2_LAST=<last name of ID2>
# another real user that is not one of the identities (hardened route "other real user" case; empty -> SKIP)
OTHER_USER_UID=

# ---- QA fixtures (writes happen ONLY here) ---------------------------------
# read fixture: project / CLA group / company where ID1 is a CLA manager
PROJECT_SFID=<Salesforce project id>
FOUNDATION_SFID=
CLA_GROUP=<CLA group id>
CLA_GROUP_NAME=<CLA group name>
COMPANY_ID=<EasyCLA company id>
COMPANY_SFID=<Salesforce account id>
COMPANY_CCLA=<CCLA signature id>
COMPANY_NAME=<company name>
COMPANY_WEBSITE=
# write fixture (fixture_writes / interactions chains): ID1 must be in this CCLA's signatureACL (not only ACS)
WRITE_PROJECT_SFID=<Salesforce project id>
WRITE_CLA_GROUP=<CLA group id>
WRITE_CLA_GROUP_NAME=<CLA group name>
WRITE_COMPANY_ID=<EasyCLA company id>
WRITE_COMPANY_SFID=<Salesforce account id>
WRITE_COMPANY_CCLA=<CCLA signature id>
WRITE_COMPANY_NAME=<company name>
# approval-list probe values (added then removed by fixture_writes). Username entries make EasyCLA create or re-parent
# the account's user record, so they must be suite-owned: empty QA_GITHUB_USER falls back to ID2_GITHUB, an empty
# QA_GITLAB_USER skips the GitLab-username probe. Organization/group entries touch no user record - public names are fine.
QA_GITHUB_USER=
QA_GITHUB_ORG=github
QA_GITLAB_USER=
QA_GITLAB_ORG=gitlab-org
# second company on the same group where ID1 holds NO scope (403 expected; empty -> SKIP)
COMPANY2_ID=
COMPANY2_SFID=
COMPANY2_CCLA=
COMPANY2_NAME=
# company / project ID1 is unrelated to (identity boundary; empty -> SKIP)
OTHER_COMPANY_ID=
OTHER_PROJECT_SFID=
# ID1's own ECLA / ICLA signature ids on the read fixture (empty -> SKIP)
ID1_ECLA=
ID1_ICLA=
# a sanctioned company (writes must be refused with 403; empty -> SKIP)
SANCTIONED_ID=
SANCTIONED_SFID=
# an organization ID1 is NOT an admin of (bridge case "another company's organization view")
OTHER_ORG_SFID=<Salesforce account id>
OTHER_ORG_NAME=<organization name>
# organizations ID1 administers (comma separated Salesforce account ids): the Organization selector must list exactly these
ID1_ADMIN_ORG_SFIDS=<sfid>,<sfid>
# company where ID1 is a CLA manager but NOT an org admin (EasyCLA-only Organization page)
CLA_ONLY_COMPANY_ID=<EasyCLA company id>
CLA_ONLY_COMPANY_SFID=<Salesforce account id>
CLA_ONLY_COMPANY_CCLA=<CCLA signature id>

# ---- M3 org-lens fixture (Organization lens -> EasyCLA -> agreement detail; approval-list / auto-ECLA / manager writes) ----
M3_ORG_SFID=<Salesforce account id>
M3_ORG_NAME=<organization name>
M3_CLA_GROUP=<CLA group id>
M3_CLA_GROUP_NAME=<CLA group name>
M3_CCLA=<CCLA signature id>
M3_PROJECT_SFID=<Salesforce project id>

# ---- dev-only signing fixtures (DocuSign demo; empty on prod) --------------
ICLA_GROUP=
ICLA_GROUP_SEARCH=
ORGSIGN_GROUP=
ORGSIGN_GROUP_SEARCH=
ORGSIGN_PROJECT_SFID=

# ---- dev-only GitHub PR flow (empty on prod) ---------------------------------
# repository with the EasyCLA GitHub app installed; the suite pushes a branch and opens/closes a PR there
GITHUB_REPO=
# prod: communitybridge-easycla[bot]
GITHUB_BOT=dev-communitybridge-easycla[bot]

# ---- LaunchDarkly (flag names the SS front end evaluates; read from the browser, never written) ----
LD_FLAG_FILTER=cla|org-lens|easycla|m1|m2|m3
LD_FLAG_M3=org-lens-cla-m3-enabled
# 1 when the LD rule targets both identities (Organization lens CLA-only pages render for ID2 as well)
ID2_LD_TARGETED=1

# seconds a chain waits for a CLA-manager grant/revoke to become visible to Self Serve (ACS authorize cache ~30 min;
# dev flushes that cache through utils/dev_acs_role_flip.sh so a short budget is enough) before reporting INFO/SKIP
# prod: 1800
SS_PROPAGATION_SECS=180

# ---- gates (1 enables; prod keeps DocuSign / company creation / GitHub PR at 0) ----
ALLOW_DOCUSIGN=1
# company creation makes a persistent Salesforce organization - opt in explicitly (dev only, never on prod)
ALLOW_COMPANY_CREATE=0
ALLOW_GITHUB_PR=1
ALLOW_FIXTURE_WRITES=1
# the I4B contact-manager request e-mails ID1 (own mailbox); 0 skips it
ALLOW_EMAIL=1
