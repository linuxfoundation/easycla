#
# Copy to tests/role-matrix/.env (git-ignored). Never commit real credentials.

# Target environment (defaults are dev).
APP_URL=https://api-gw.dev.platform.linuxfoundation.org/
AUTH0_TOKEN_API=https://linuxfoundation-dev.auth0.com/oauth/token
# Auth0 application that allows the password-realm grant for the stage.
AUTH0_CLIENT_ID=

# Personas. Name = role (manager|orgadmin|member|outsider), optional digit suffix for a
# second account with the same role (e.g. RM_ORGADMIN2_*). Anonymous is always included.
# Either a username/password pair (password-realm grant), or a pasted access token for
# MFA-enrolled accounts.
RM_MANAGER_USERNAME=
RM_MANAGER_PASSWORD=
#RM_MANAGER_TOKEN=
RM_ORGADMIN_USERNAME=
RM_ORGADMIN_PASSWORD=
RM_MEMBER_USERNAME=
RM_MEMBER_PASSWORD=
RM_OUTSIDER_USERNAME=
RM_OUTSIDER_PASSWORD=

# Fixtures. Defaults are Infosys Limited / SUN on dev (same as the Cypress v4 suite).
#RM_COMPANY_ID=f7c7ac9c-4dbf-4104-ab3f-6b38a26d82dc
#RM_COMPANY_SFID=0014100000Te0G7AAJ
#RM_PROJECT_SFID=a09P000000DsCE5IAN
#RM_CLA_GROUP_ID=01af041c-fa69-4052-a23c-fb8c1d3bef24
# LFID used for the DELETE probe; must not be a CLA manager of the fixture CCLA.
#RM_NON_MANAGER_LFID=role-matrix-no-such-lfid
