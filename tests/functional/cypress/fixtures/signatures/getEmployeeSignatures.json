{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "resultCount": {
      "type": "integer"
    },
    "totalCount": {
      "type": "integer"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signatureID": {
            "type": "string"
          },
          "userID": {
            "type": "string"
          },
          "companyID": {
            "type": "string"
          },
          "projectID": {
            "type": "string"
          },
          "signatureType": {
            "type": "string"
          },
          "employeeSignature": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": ["signatures"]
}