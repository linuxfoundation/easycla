{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pageSize": {
      "type": "integer"
    },
    "lastKeyScanned": {
      "type": ["string", "null"]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "projectID": {
            "type": "string"
          },
          "projectExternalID": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          }
        }
      }
    }
  }
}