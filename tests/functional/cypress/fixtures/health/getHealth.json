{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "Status": {
      "type": "string",
      "enum": ["healthy", "unhealthy"]
    },
    "TimeStamp": {
      "type": "string"
    },
    "Version": {
      "type": "string"
    },
    "Commit": {
      "type": "string"
    },
    "Branch": {
      "type": "string"
    },
    "BuildDate": {
      "type": "string"
    }
  },
  "required": [
    "Status"
  ]
}