          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "templateVariable": {
              "type": "string"
            }
          }
        }
      },
      "iclaFields": {
        "type": "array"
      },
      "cclaFields": {
        "type": "array"
      }
