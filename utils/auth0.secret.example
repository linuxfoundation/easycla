# Template for utils/auth0-dev.secret / utils/auth0-prod.secret (both gitignored via *.secret).
# Copy, fill in, chmod 600. Parsed as plain KEY=VALUE lines - never sourced.
# Client IDs live in separate one-line gitignored files next to this one (also chmod 600):
#   auth0-dev-client-id.secret, auth0-prod-client-id.secret (ordinary token)
#   auth0-dev-azp-client-id.secret, auth0-prod-azp-client-id.secret (azp mode)
AUTH0_USERNAME=your-lf-sso-username
AUTH0_PASSWORD=your-lf-sso-password
# For azp mode; optional when kubectl can read the matching Self Serve client's configuration:
# AUTH0_AZP_CLIENT_SECRET=
# Ordinary-token overrides (ignored in azp mode):
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_AUDIENCE=
# AUTH0_TENANT=
# AUTH0_REDIRECT_URI=
